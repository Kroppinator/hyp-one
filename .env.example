# E-Mail-Versand für das Kontaktformular
# Diese Werte in Vercel unter Settings -> Environment Variables eintragen
# (und lokal in einer .env.local-Datei, die NICHT eingecheckt wird).

EMAIL_HOST=smtp.gmx.de
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=deine-adresse@gmx.de
EMAIL_PASSWORD=dein-passwort
EMAIL_FROM=noreply@transformationbeiisa.de
EMAIL_TO=kontakt@transformationbeiisa.de
