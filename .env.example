# E-Mail-Versand für das Kontaktformular
#
# Diese Werte in Vercel unter Settings -> Environment Variables eintragen
# (Environment: Production, Preview und Development) und danach EINMAL NEU
# DEPLOYEN – sonst greifen sie nicht. Lokal gehören sie in eine Datei
# .env.local, die bewusst nicht eingecheckt wird.
#
# Wichtig bei GMX:
#  - Im GMX-Konto muss der Zugriff über POP3/IMAP freigeschaltet sein,
#    sonst lehnt der Server die Anmeldung ab.
#  - EMAIL_FROM muss dieselbe Adresse sein wie EMAIL_USER. GMX verweigert
#    den Versand unter einer fremden Absenderadresse.

EMAIL_HOST=smtp.gmx.net
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=isabelle-kroppenstedt@gmx.de
EMAIL_PASSWORD=hier-das-postfach-passwort
EMAIL_FROM=isabelle-kroppenstedt@gmx.de
EMAIL_TO=isabelle-kroppenstedt@gmx.de
